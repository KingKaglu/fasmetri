# ── Database (required) ────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ── Site ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://fasmetri.vercel.app"

# ── Admin (required for /admin) ────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# HMAC secret for the admin session cookie. Optional but recommended: if
# unset, the signing key is derived from ADMIN_PASSWORD (never a public
# constant in production), so changing the password logs admins out. Set this
# to decouple session rotation from the password. Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# ── Scraper / import ───────────────────────────────────────────────
SCRAPER_ENABLED="false"
SCRAPER_MAX_PRODUCTS_PER_SHOP="120"
SCRAPER_USER_AGENT="FasmetriPriceBot/0.1 (+hello@fasmetri.ge)"
CRON_SECRET="change-me"

# ── Analytics (all optional — site works fine if empty) ────────────
# NOTE: this is a Next.js app, so client vars use the NEXT_PUBLIC_ prefix
# (not VITE_). Leave blank to disable a provider.
NEXT_PUBLIC_GA_ID=""              # Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""      # Meta (Facebook) Pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""    # TikTok Pixel ID

# Analytics only load after the visitor consents (Georgian data-protection law
# requires prior consent). Setting an ID here is enough — no code change.

# ── Price-alert email (required for alerts to send at all) ────────
# Pick ONE transport. With neither set, evaluate-alerts sends nothing and
# leaves triggered alerts ACTIVE so nothing is lost — but nobody is told.
#
# Set it in BOTH places, because they are different runtimes:
#   1. Vercel  — the site itself (a variable that exists with an EMPTY value
#                counts as unset; that is how this was missed for months)
#   2. GitHub  — `gh secret set RESEND_API_KEY`. Alerts are evaluated by the
#                store sync workflows, NOT on Vercel, so the key must reach
#                Actions too or the evaluator has nothing to send with.
#
# The From domain must be a verified sending domain in Resend.
RESEND_API_KEY=""
ALERT_EMAIL_FROM="Fasmetri <alerts@fasmetri.ge>"
# Or plain SMTP instead of Resend:
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# First-party shop_click storage uses the existing DATABASE_URL (server-side,
# via /api/out → ClickEvent). No client-side Supabase keys are required.
